__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.claude
.ruff_cache

# pytest tmp_path base (see pyproject addopts)
.pytest_tmp/
.pytest_cache/

# experiment outputs
runs/
outputs/
*.safetensors

# datasets (Cityscapes is not redistributable). Rooted on purpose:
# a bare "data/" would also swallow the src/calora/data package.
/data/
/cityscapes/

# results/ is the tracked copy of the run outputs behind REPORT.md; exempt it
# from the rules above.
!/results/
!/results/**
